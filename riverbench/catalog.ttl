<https://w3id.org/riverbench/datasets/osm2rdf-denmark/dev>
    a dcat:Dataset ;
    dct:title "OpenStreetMap Denmark (osm2rdf)"@en ;
    dct:description "The dataset is based on datasets that were derived from OpenStreetMap data using the osm2rdf tool. It includes information about each element which is of type node (osm:node), way (osm:way) or relation (osm:relation). Nodes are a core concept in OSM and they represent a single point in space defined by geographic coordinates. A node itself can describe for example a city, town, road junction, post box etc. A way is line, represents linear features on the ground - like a road. It consist of an ordered node list. A relation is a colection of the three core elements: nodes, ways and relations. Each element contains all atributes associated with it.\n\nThe elements were shuffled to ensure that, regardless of the size of the selected subset, the proportions of different types of elements are preserved"@en ;
    dct:creator [ foaf:name "Axel Lehmann" ] ;
    dct:creator [ foaf:name "Hannah Bast" ] ;
    dct:creator [ foaf:name "Johannes Kalmbach" ] ;
    dct:creator [ foaf:name "Karol Nowiński" ; foaf:homepage <https://github.com/karol-nowinski> ] ;
    dct:creator [ foaf:name "OpenStreetMap & contributors" ; foaf:homepage <https://wiki.openstreetmap.org/wiki/Contributors#Denmark>, <https://www.openstreetmap.org/> ] ;
    dct:creator [ foaf:name "Patrick Brosi" ] ;
    dct:license <https://spdx.org/licenses/ODbL-1.0> ;
    dct:issued "2025-01-18"^^xsd:date ;
    dcat:landingPage <https://w3id.org/riverbench/datasets/osm2rdf-denmark/dev> ;
    dcat:theme eurovoc:336 , eurovoc:5269 , eurovoc:c_7a168de0 ;
    rb:hasStreamElementCount "2030923"^^xsd:integer ;
    dcat:distribution <https://ldes.tech/riverbench/osm2rdf-denmark/root.trig#EventStream> .

# The IRI of the LDES is the entry point that a client is given
