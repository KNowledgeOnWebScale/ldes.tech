    rb:hasStreamElementCount "1440415"^^xsd:integer ;
    dcat:distribution <https://ldes.tech/riverbench/digital-agenda-indicators/root.trig#EventStream> .

# The IRI of the LDES is the entry point that a client is given
<https://ldes.tech/riverbench/digital-agenda-indicators/root.trig#EventStream> a ldes:EventStream ;
