@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ldes.tech/riverbench/> a dcat:Catalog ;
    dct:title "RiverBench datasets as LDES 2.0"@en ;
    dct:description "A catalog of the datasets of RiverBench (https://w3id.org/riverbench), an open RDF streaming benchmark suite. 10 of its 15 datasets are described as an LDES 2.0 (a distribution of the dataset) that links to the Jelly-RDF file that RiverBench hosts."@en ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0> ;
    dct:rights "The metadata of the datasets is derived from the metadata of RiverBench, which is licensed under CC BY 4.0. The datasets are licensed under their own license."@en ;
    prov:wasDerivedFrom <https://w3id.org/riverbench/> ;
    foaf:homepage <https://ldes.tech/riverbench/> ;
