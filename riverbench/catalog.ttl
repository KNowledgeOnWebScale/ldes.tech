<https://w3id.org/riverbench/datasets/officegraph/dev>
    a dcat:Dataset ;
    dct:title "OfficeGraph"@en ;
    dct:description "[OfficeGraph](https://github.com/RoderickvanderWeerdt/OfficeGraph/tree/main) is a real-world dataset of measurements from 444 IoT devices taken over 11 months. The devices are made up of 17 different sensor models which measure different properties. The data was collected in a Dutch 7-story office building and consists of about 90 million RDF triples. See also the [paper](https://doi.org/10.1007/978-3-031-60635-9_6) for more details.\n\nThe elements in the dataset are ordered from oldest to newest by the measurement time (saref:hasTimestamp predicate).\n\nAdditional data such as the metadata about the devices taking measurements and rooms in the building, as well as copy of this dataset can be found [on Zenodo](https://doi.org/10.5281/zenodo.14690081)."@en ;
    dct:creator [ foaf:name "Adam Skaskiewicz" ] ;
    dct:creator [ foaf:name "Frank van Harmelen" ] ;
    dct:creator [ foaf:name "Roderick van der Weerdt" ] ;
    dct:creator [ foaf:name "Ronald Siebes" ] ;
    dct:creator [ foaf:name "Ronnie Groenewold" ] ;
    dct:creator [ foaf:name "Victor de Boer" ] ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0> ;
    dct:issued "2025-01-18"^^xsd:date ;
    dcat:landingPage <https://w3id.org/riverbench/datasets/officegraph/dev> ;
    dcat:theme eurovoc:6030 , eurovoc:c_4b5a18f8 , eurovoc:c_b12a760a ;
    dcat:temporalResolution "PT1M"^^xsd:duration ;
    rb:hasStreamElementCount "14930478"^^xsd:integer ;
    dcat:distribution <https://ldes.tech/riverbench/officegraph/root.trig#EventStream> .

# The IRI of the LDES is the entry point that a client is given
<https://ldes.tech/riverbench/officegraph/root.trig#EventStream> a ldes:EventStream ;
    dct:title "OfficeGraph as an LDES: the first 10 000 elements, in Jelly-RDF"@en ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0> ;
    dcat:accessURL <https://ldes.tech/riverbench/officegraph/root.trig> ;
    # This LDES is a view on the RiverBench Jelly distribution with 10K elements (181 KB)
    prov:wasDerivedFrom <https://w3id.org/riverbench/datasets/officegraph/dev#jelly-10k> ;
    rb:hasStreamElementCount 10000 .

<https://w3id.org/riverbench/datasets/openaire-lod/dev>
    a dcat:Dataset ;
    dct:title "OpenAIRE LOD graph"@en ;
    dct:description "[OpenAIRE LOD](https://web.archive.org/web/20201230151925/http://lod.openaire.eu/documentation) was a service that exported data from the OpenAIRE information space in RDF format, using Linked Open Data principles. The data was exported to Zenodo, with the [last dump dated at March 3, 2021](https://zenodo.org/records/4587369). This dataset consists of the \"result\" subset of the OpenAIRE LOD graph, including scientific results such as publications.\n\nOnly records that were valid RDF and had the \"dateofcollection\" property were included here. They were then sorted by the date of collection in ascending order. The first 2 (out of 28) million records that were obtained in this way are a part of this dataset.\n\nSee also [the project documentation](https://web.archive.org/web/20201230151925/http://lod.openaire.eu/documentation) and [the used ontology](https://web.archive.org/web/20201230151925/http://lod.openaire.eu/vocab).\n"@en ;
    dct:creator [ foaf:name "Christoph Lange" ] ;
    dct:creator [ foaf:name "George Papastefanatos" ; foaf:homepage <https://orcid.org/0000-0002-9273-9843> ] ;
    dct:creator [ foaf:name "Giorgos Alexiou" ; foaf:homepage <https://orcid.org/0000-0003-2244-4916> ] ;
    dct:creator [ foaf:name "Piotr Sowiński" ; foaf:homepage <https://github.com/Ostrzyciel>, <https://orcid.org/0000-0002-2543-9461> ] ;
    dct:creator [ foaf:name "Sahar Vahdati" ] ;
    dct:license <https://spdx.org/licenses/CC0-1.0> ;
    dct:issued "2024-07-12"^^xsd:date ;
    dct:language "en" ;
    dcat:landingPage <https://w3id.org/riverbench/datasets/openaire-lod/dev> ;
    dcat:theme eurovoc:2896 , eurovoc:2924 , eurovoc:4864 , eurovoc:6306 , eurovoc:c_5ea6e5c4 , eurovoc:c_99a79cea ;
    rb:hasStreamElementCount "2000000"^^xsd:integer ;
    dcat:distribution <https://ldes.tech/riverbench/openaire-lod/root.trig#EventStream> .

# The IRI of the LDES is the entry point that a client is given
<https://ldes.tech/riverbench/openaire-lod/root.trig#EventStream> a ldes:EventStream ;
    dct:title "OpenAIRE LOD graph as an LDES: the first 10 000 elements, in Jelly-RDF"@en ;
    dct:license <https://spdx.org/licenses/CC0-1.0> ;
    dcat:accessURL <https://ldes.tech/riverbench/openaire-lod/root.trig> ;
