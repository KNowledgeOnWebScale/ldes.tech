# No LDES for this dataset: The smallest Jelly distribution that RiverBench offers for this dataset (10K elements) is
# 69.9 MB: too large to read in a browser.
<https://w3id.org/riverbench/datasets/dbpedia-live/dev>
    a dcat:Dataset ;
    dct:title "DBpedia Live"@en ;
    dct:description "[DBpedia Live](https://www.dbpedia.org/resources/live/) was a real-time service that monitored edits on Wikipedia and published a stream of changes to the DBpedia knowledge graph. This dataset contains only the \"added\" triples in the stream, so it does not include deletes or other types of changes. Only one month (January 2014) is covered at the moment, but the dataset can be easily expanded in the future (the service stopped functioning in 2021). The stream's elements are irregular in size, depending on the volume of traffic on Wikipedia at a given moment and how the DBpedia Live service was able to cope with it. See also the [paper](http://jens-lehmann.org/files/2012/program_el_dbpedia_live.pdf).\n    \nThe dataset was extensively cleaned to fix or remove bad IRIs, bad Unicode, and invalid literals."@en ;
    dct:creator [ foaf:name "DBpedia Association" ; foaf:homepage <https://www.dbpedia.org/contact/> ] ;
    dct:creator [ foaf:name "Piotr Sowiński" ; foaf:homepage <https://github.com/Ostrzyciel>, <https://orcid.org/0000-0002-2543-9461> ] ;
    dct:creator [ foaf:name "Wikipedia contributors" ; foaf:homepage <https://www.wikipedia.org/> ] ;
    dct:license <https://spdx.org/licenses/CC-BY-SA-3.0> ;
    dct:issued "2023-05-09"^^xsd:date ;
    dcat:landingPage <https://w3id.org/riverbench/datasets/dbpedia-live/dev> ;
    dcat:theme eurovoc:4137 , eurovoc:c_5ea6e5c4 ;
    rb:hasStreamElementCount "166204"^^xsd:integer .

<https://w3id.org/riverbench/datasets/digital-agenda-indicators/dev>
    a dcat:Dataset ;
    dct:title "EU Digital Agenda Key Indicators"@en ;
    dct:description "The dataset of [EU Digital Agenda Key Indicators](https://digital-agenda-data.eu/datasets/digital_agenda_scoreboard_key_indicators) contains statistical information about the European information society. The dataset is composed of a series of statistical observations with various properties and a very regular structure.\n\nThis is a large, typical dataset with statistical information, with a very regular structure. In contrast to [linked-spending](https://w3id.org/riverbench/datasets/linked-spending/dev), this dataset does not include textual information and is more homogenous, making it an interesting comparison point for aggressive compression algorithms."@en ;
    dct:creator [ foaf:name "European Commission, Directorate-General for Communications Networks, Content and Technology" ; foaf:homepage <https://commission.europa.eu/index_en> ] ;
    dct:creator [ foaf:name "Piotr Sowiński" ; foaf:homepage <https://github.com/Ostrzyciel>, <https://orcid.org/0000-0002-2543-9461> ] ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0> ;
    dct:issued "2023-05-04"^^xsd:date ;
